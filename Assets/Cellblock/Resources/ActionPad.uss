/* The staff action pad (Hard Time-style buttons) for direct control. Loaded by GameActionPad; other style sheets are not modified. */
.action-pad { position: absolute; width: 150px; align-items: flex-end; }
.action-feedback { white-space: normal; width: 260px; font-size: 11px; color: rgb(236, 228, 204); padding: 6px 8px; margin-bottom: 6px; border-radius: 4px; background-color: rgba(18, 26, 30, 0.86); border-left-width: 3px; border-left-color: rgb(197, 177, 126); -unity-text-align: middle-left; }
.action-target { font-size: 10px; letter-spacing: 1px; color: rgb(170, 182, 176); padding: 3px 7px; margin-bottom: 4px; border-radius: 3px; background-color: rgba(18, 26, 30, 0.72); -unity-text-align: middle-right; }
.action-target.action-target-live { color: rgb(244, 214, 140); }
.action-wind { width: 140px; height: 5px; margin-bottom: 6px; border-radius: 3px; background-color: rgba(18, 26, 30, 0.75); overflow: hidden; }
.action-wind-fill { height: 5px; background-color: rgb(86, 168, 140); }
.action-wind-fill.low { background-color: rgb(196, 110, 73); }
.action-grid { width: 140px; flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.action-pad .action-button { width: 66px; height: 66px; margin: 0 0 8px 0; padding: 0; border-radius: 33px; border-width: 2px; align-items: center; justify-content: center; background-color: rgba(28, 40, 46, 0.86); border-color: rgba(198, 186, 146, 0.45); }
.action-button:disabled { opacity: 0.45; }
.action-label { font-size: 10px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(236, 230, 210); white-space: normal; -unity-text-align: middle-center; max-width: 60px; }
.action-key { font-size: 9px; color: rgb(170, 182, 176); -unity-text-align: middle-center; margin-top: 1px; }
.action-attack.action-ready { background-color: rgba(150, 52, 44, 0.9); border-color: rgb(232, 150, 128); }
.action-grab.action-ready { background-color: rgba(52, 92, 132, 0.9); border-color: rgb(150, 192, 232); }
.action-grab.action-holding { background-color: rgba(46, 118, 150, 0.95); border-color: rgb(196, 230, 244); }
.action-pickup.action-ready { background-color: rgba(140, 112, 44, 0.9); border-color: rgb(232, 206, 128); }
.action-use.action-ready { background-color: rgba(52, 118, 92, 0.9); border-color: rgb(146, 222, 186); }
.action-pad .action-run-toggle { width: 140px; height: 44px; border-radius: 22px; margin: 0; flex-direction: row; }
.action-run-toggle .action-key { margin-top: 0; margin-left: 6px; }
.action-run-toggle.selected { background-color: rgba(86, 168, 140, 0.9); border-color: rgb(186, 236, 212); }
.action-crosshair { position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; margin-left: -3px; margin-top: -3px; border-radius: 3px; background-color: rgba(244, 238, 220, 0.75); border-width: 1px; border-color: rgba(18, 26, 30, 0.6); }
.action-crosshair.action-crosshair-live { width: 10px; height: 10px; margin-left: -5px; margin-top: -5px; border-radius: 5px; background-color: rgba(244, 196, 96, 0.9); }
/* Floating move pad (Claude, 2026-10-19): an invisible zone; the ring appears under the thumb, a faint ring marks it at rest. */
.character-move-zone { position: absolute; background-color: rgba(0, 0, 0, 0); }
.character-move-rest { position: absolute; left: 22px; bottom: 22px; width: 84px; height: 84px; border-radius: 42px; border-width: 2px; border-color: rgba(236, 230, 210, 0.28); background-color: rgba(18, 26, 30, 0.14); }
.character-move-ring { position: absolute; width: 100px; height: 100px; border-radius: 50px; border-width: 2px; border-color: rgba(236, 230, 210, 0.55); background-color: rgba(18, 26, 30, 0.22); align-items: center; justify-content: center; }
.character-move-ring .character-stick-knob { position: absolute; left: 31px; top: 31px; width: 38px; height: 38px; border-radius: 19px; background-color: rgba(236, 230, 210, 0.7); }
.character-move-ring.sprint { border-color: rgba(146, 222, 186, 0.9); }
.character-move-ring.sprint .character-stick-knob { background-color: rgba(146, 222, 186, 0.95); }
/* Touch officer bar (Claude, 2026-10-19): chips over the world, not a panel. */
.character-touch.character-control-bar { background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 0; }
.character-touch .character-control-top { flex-wrap: nowrap; }
.character-touch .character-control-exit { min-width: 44px; min-height: 44px; font-size: 13px; padding: 0 12px; }
.character-touch .character-control-name { flex-grow: 1; flex-shrink: 1; font-size: 13px; padding: 0 12px; color: rgb(244, 240, 222); text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8); white-space: nowrap; }
.character-touch .character-control-actions { flex-grow: 0; }
.character-touch .character-control-button { flex-grow: 0; min-height: 44px; min-width: 52px; background-color: rgba(23, 36, 40, 0.86); }
.character-more { font-size: 18px; }
.character-context-stale { visibility: hidden; }
