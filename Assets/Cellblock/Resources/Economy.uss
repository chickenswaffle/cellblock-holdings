/* Prison economy: the Company section and the Money block on a resident's card. Loaded by GameEconomyHud; other style sheets are not modified. */
.economy-heading { color: rgb(150, 170, 168); font-size: 9px; letter-spacing: 1.4px; margin-top: 12px; margin-bottom: 4px; }
.economy-line { white-space: normal; font-size: 12px; color: rgb(214, 222, 213); margin-bottom: 6px; }
.economy-small { white-space: normal; font-size: 11px; color: rgb(160, 176, 174); margin-bottom: 6px; }
.economy-chips { flex-direction: row; flex-wrap: wrap; align-items: center; margin: 0 -2px 6px -2px; }
.economy-chips Button { flex-grow: 1; min-width: 46px; min-height: 34px; font-size: 11px; padding-left: 5px; padding-right: 5px; margin: 2px; }
.price-row { flex-direction: row; align-items: center; padding: 4px 8px; margin-bottom: 3px; border-radius: 4px; background-color: rgb(32, 41, 44); }
.price-text { flex-grow: 1; flex-shrink: 1; white-space: normal; font-size: 11px; color: rgb(214, 222, 213); margin-right: 6px; }
Button.price-buy { min-width: 68px; min-height: 34px; flex-shrink: 0; font-size: 11px; }
.money-card { padding: 8px 10px 4px 10px; margin: 8px 0 6px 0; border-left-width: 3px; border-left-color: rgb(196, 170, 112); border-radius: 3px; background-color: rgb(34, 40, 36); }
.money-card .section-label { margin-top: 0; }
.money-line { white-space: normal; font-size: 12px; -unity-font-style: bold; color: rgb(236, 228, 204); margin-bottom: 4px; }
.money-small { white-space: normal; font-size: 11px; color: rgb(184, 196, 188); margin-bottom: 4px; }
