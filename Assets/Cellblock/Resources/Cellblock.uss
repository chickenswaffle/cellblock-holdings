:root { color: rgb(235, 234, 223); font-size: 14px; }
Label { -unity-text-align: upper-left; margin: 0; padding: 0; }
Button { min-height: 44px; flex-shrink: 0; margin: 2px; padding: 7px 13px; background-color: rgb(42, 49, 51); color: rgb(230, 232, 224); border-width: 1px; border-color: rgb(66, 76, 77); border-radius: 5px; font-size: 13px; -unity-font-style: normal; -unity-text-align: middle-center; }
Button:hover { background-color: rgb(60, 72, 74); border-color: rgb(135, 152, 149); }
Button:active { background-color: rgb(76, 88, 86); }
Button:focus { border-color: rgb(222, 188, 140); }
Button:disabled { opacity: 0.35; }
Button.selected { background-color: rgb(217, 188, 144); border-color: rgb(217, 188, 144); color: rgb(30, 35, 36); -unity-font-style: bold; }
Button.primary { background-color: rgb(217, 188, 144); border-color: rgb(217, 188, 144); color: rgb(29, 35, 36); -unity-font-style: bold; }
Button.primary:hover { background-color: rgb(238, 214, 173); border-color: rgb(238, 214, 173); }
Button.quiet { background-color: rgba(255, 255, 255, 0.025); border-color: rgb(70, 80, 81); }
Button.danger { color: rgb(230, 157, 139); }
Button.text-button { min-height: 44px; margin-top: -10px; margin-bottom: -8px; padding-left: 8px; padding-right: 8px; background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); color: rgb(168, 179, 176); font-size: 11px; }
.header, .inspector, .tools, .quote, .camera-panel { background-color: rgba(25, 32, 35, 0.97); border-width: 1px; border-color: rgb(69, 80, 82); border-radius: 7px; }
.header { position: absolute; flex-direction: row; align-items: center; justify-content: space-between; padding: 8px 14px; }
.identity { flex-direction: row; align-items: center; flex-shrink: 1; margin-right: 20px; }
.brand-mark { width: 43px; height: 43px; border-width: 1px; border-color: rgb(189, 165, 126); color: rgb(224, 198, 157); font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center; margin-right: 12px; }
.identity-copy { flex-shrink: 1; }
.brand { font-size: 14px; letter-spacing: 2.1px; -unity-font-style: bold; }
.eyebrow, .metric-label { color: rgb(152, 173, 173); font-size: 10px; letter-spacing: 1.4px; margin-bottom: 6px; white-space: normal; }
.identity .eyebrow { margin-top: 5px; margin-bottom: 0; font-size: 9px; letter-spacing: 0.7px; }
.balance { min-width: 132px; margin-right: 20px; }
.cash { color: rgb(231, 210, 174); font-size: 25px; -unity-font-style: bold; }
.occupancy { min-width: 130px; margin-right: 20px; }
.metric-value { font-size: 23px; color: rgb(222, 229, 223); }
.time-control { align-items: center; margin-right: 16px; }
.clock { font-size: 11px; letter-spacing: 1px; color: rgb(193, 205, 199); margin-bottom: 4px; }
.speed-strip { flex-direction: row; }
Button.speed-button { min-height: 44px; min-width: 44px; padding: 2px 8px; margin: 0 1px; border-radius: 3px; font-size: 12px; }
.header-actions { flex-direction: row; align-items: center; }
.header-actions Button { min-width: 65px; }
.navigation { position: absolute; height: 46px; flex-direction: row; align-items: center; justify-content: space-between; }
.workspace-tabs { flex-direction: row; align-items: center; padding: 2px; background-color: rgba(25, 32, 35, 0.97); border-width: 1px; border-color: rgb(69, 80, 82); border-radius: 7px; }
.workspace-tabs Button { min-width: 101px; min-height: 40px; border-radius: 4px; border-color: rgba(0, 0, 0, 0); background-color: rgba(0, 0, 0, 0); margin: 0 1px; }
.workspace-tabs Button.selected { background-color: rgb(217, 188, 144); color: rgb(30, 35, 36); }
.navigation-utilities { flex-direction: row; padding: 2px; background-color: rgba(25, 32, 35, 0.97); border-width: 1px; border-color: rgb(69, 80, 82); border-radius: 7px; }
.navigation-utilities Button { min-height: 40px; margin: 0 1px; border-color: rgba(0, 0, 0, 0); background-color: rgba(0, 0, 0, 0); }
.navigation-utilities Button.selected { background-color: rgb(217, 188, 144); color: rgb(30, 35, 36); }
.inspector { position: absolute; width: 314px; padding: 16px 13px; }
.panel-heading { flex-direction: row; justify-content: space-between; align-items: center; min-height: 30px; margin-bottom: 7px; }
.panel-heading .eyebrow { margin-bottom: 0; }
.card-title { font-size: 23px; -unity-font-style: bold; white-space: normal; margin-bottom: 9px; color: rgb(240, 235, 219); }
.overview { color: rgb(165, 183, 181); font-size: 12px; white-space: normal; margin-bottom: 18px; padding-bottom: 15px; border-bottom-width: 1px; border-bottom-color: rgb(65, 77, 79); }
.body { white-space: normal; font-size: 13px; margin-bottom: 12px; color: rgb(210, 218, 210); }
.muted { white-space: normal; color: rgb(146, 165, 165); font-size: 11px; margin-top: 4px; margin-bottom: 8px; }
.section-label { color: rgb(187, 164, 132); font-size: 10px; letter-spacing: 1.5px; margin-top: 18px; margin-bottom: 10px; }
.selection-empty .section-label { margin-top: 0; }
.selection-card { padding: 12px 10px; border-width: 1px; border-color: rgb(70, 86, 87); border-radius: 5px; background-color: rgb(34, 44, 47); margin-bottom: 6px; }
.wrap-row { flex-direction: row; flex-wrap: wrap; align-items: center; margin-left: -2px; margin-right: -2px; }
.wrap-row Button { flex-grow: 1; min-width: 84px; font-size: 12px; padding-left: 8px; padding-right: 8px; }
.terms { white-space: normal; color: rgb(213, 222, 211); font-size: 12px; margin-top: 2px; margin-bottom: 6px; }
.ledger-line { white-space: normal; margin-bottom: 10px; padding: 0 0 10px 0; border-bottom-width: 1px; border-bottom-color: rgb(55, 67, 69); color: rgb(207, 183, 161); font-size: 12px; }
.ledger-line.credit { color: rgb(170, 205, 183); }
.crew-line { white-space: normal; font-size: 12px; color: rgb(195, 210, 201); padding: 8px 0; border-bottom-width: 1px; border-bottom-color: rgb(55, 67, 69); }
.project-card { padding: 10px; margin-bottom: 8px; background-color: rgb(34, 44, 47); border-radius: 4px; }
.project-name { white-space: normal; color: rgb(221, 225, 214); font-size: 12px; margin-bottom: 8px; }
.progress-track { height: 4px; background-color: rgb(64, 75, 75); border-radius: 2px; margin-bottom: 5px; overflow: hidden; }
.progress-fill { height: 4px; background-color: rgb(210, 178, 128); }
.project-card .muted { font-size: 10px; margin-bottom: 0; }
.tools { position: absolute; min-height: 64px; padding: 7px; }
.tool-strip { flex-direction: row; align-items: center; }
.tool-button { min-width: 88px; min-height: 44px; padding-left: 15px; padding-right: 15px; margin-right: 5px; }
.snap-button { min-width: 95px; margin-left: 12px; }
.status { position: absolute; background-color: rgba(25, 32, 35, 0.9); border-left-width: 3px; border-left-color: rgb(174, 155, 121); border-radius: 3px; padding: 11px 15px; }
.status-empty { visibility: hidden; }
.instruction { white-space: normal; color: rgb(227, 232, 221); font-size: 12px; }
.placement { color: rgb(229, 200, 154); font-size: 13px; white-space: normal; margin-top: 6px; -unity-font-style: bold; }
.notice { white-space: normal; color: rgb(157, 181, 180); font-size: 11px; margin-top: 5px; }
.quote { position: absolute; padding: 16px; border-top-width: 3px; border-top-color: rgb(217, 188, 144); }
.quote > ScrollView { flex-shrink: 1; }
.quote-cost { font-size: 27px; color: rgb(229, 203, 162); margin-top: 4px; margin-bottom: 13px; }
.quote-actions { flex-direction: row; margin-top: 9px; }
.quote-actions Button { flex-grow: 1; }
.camera-panel { position: absolute; width: 350px; padding: 13px 10px; }
.camera-panel > ScrollView { flex-shrink: 1; }
.camera-row { flex-direction: row; }
.camera-row Button { flex-basis: 0; flex-grow: 1; min-width: 0; padding-left: 5px; padding-right: 5px; font-size: 11px; min-height: 44px; }
.camera-panel .eyebrow { font-size: 10px; letter-spacing: 0.5px; }
.menu { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(17, 24, 28); }
.menu-masthead { flex-direction: row; align-items: center; justify-content: space-between; padding-bottom: 10px; margin-bottom: 14px; border-bottom-width: 1px; border-bottom-color: rgb(61, 76, 80); }
.menu-brand { font-size: 13px; color: rgb(200, 182, 152); letter-spacing: 2.5px; -unity-font-style: bold; }
.menu-title { font-size: 40px; color: rgb(243, 234, 211); -unity-font-style: bold; margin-bottom: 7px; letter-spacing: -1px; }
.menu-subtitle { font-size: 17px; color: rgb(196, 213, 209); white-space: normal; margin-bottom: 12px; }
.menu-intro { max-width: 1200px; color: rgb(141, 166, 170); white-space: normal; font-size: 13px; margin-bottom: 18px; }
.cards { flex-direction: row; margin-bottom: 18px; margin-left: -6px; margin-right: -6px; }
.contract-card { flex-grow: 1; flex-basis: 0; background-color: rgb(29, 39, 44); border-width: 1px; border-color: rgb(65, 83, 87); border-top-width: 3px; border-top-color: rgb(154, 140, 116); border-radius: 5px; margin: 0 6px; padding: 18px; }
.contract-topline { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.contract-topline .eyebrow { font-size: 9px; letter-spacing: 1px; margin-bottom: 0; }
.contract-tag { font-size: 8px; letter-spacing: 1px; padding: 5px 6px; background-color: rgb(42, 58, 62); color: rgb(177, 202, 199); border-radius: 3px; }
.contract-city { font-size: 10px; letter-spacing: 2px; color: rgb(154, 185, 187); margin-bottom: 7px; }
.contract-title { font-size: 23px; -unity-font-style: bold; white-space: normal; min-height: 30px; color: rgb(239, 234, 216); margin-bottom: 8px; }
.contract-description { font-size: 12px; white-space: normal; color: rgb(166, 188, 188); min-height: 34px; margin-bottom: 12px; }
.reserve-block { padding-top: 11px; padding-bottom: 11px; border-top-width: 1px; border-top-color: rgb(62, 79, 83); border-bottom-width: 1px; border-bottom-color: rgb(62, 79, 83); margin-bottom: 11px; }
.reserve-value { font-size: 34px; color: rgb(225, 199, 158); -unity-font-style: bold; }
.reserve-block .metric-label { font-size: 9px; margin-bottom: 5px; }
.finance-row { flex-direction: row; align-items: center; justify-content: space-between; padding: 5px 0; }
.finance-name { font-size: 12px; color: rgb(148, 176, 180); flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 12px; white-space: normal; }
.finance-value { font-size: 12px; color: rgb(213, 224, 216); -unity-text-align: middle-right; flex-shrink: 0; min-width: 100px; }
.contract-footnote { font-size: 10px; white-space: normal; color: rgb(141, 167, 171); margin-top: 10px; margin-bottom: 12px; flex-grow: 1; }
Button.acquire-button { margin: 0; min-height: 48px; -unity-text-align: middle-center; }
.saved-holdings { margin-bottom: 18px; }
Button.save-row { margin-left: 0; margin-right: 0; margin-bottom: 6px; min-height: 48px; white-space: normal; -unity-text-align: middle-left; padding-left: 15px; padding-right: 15px; background-color: rgb(27, 37, 42); border-color: rgb(58, 77, 81); }
.menu-footer { color: rgb(116, 145, 149); font-size: 11px; white-space: normal; margin-top: 8px; margin-bottom: 10px; }
.error-message { color: rgb(243, 171, 139); white-space: normal; font-size: 13px; padding: 10px; background-color: rgb(76, 42, 36); border-radius: 4px; }
.guide-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(11, 18, 22, 0.83); align-items: center; justify-content: center; }
.guide-sheet { width: 900px; max-width: 100%; max-height: 100%; padding: 27px; background-color: rgb(26, 37, 43); border-width: 1px; border-color: rgb(104, 121, 122); border-top-width: 3px; border-top-color: rgb(217, 188, 144); border-radius: 7px; }
.guide-sheet > ScrollView { flex-shrink: 1; }
.guide-title { font-size: 31px; -unity-font-style: bold; white-space: normal; color: rgb(242, 234, 215); margin-bottom: 12px; }
.guide-columns { flex-direction: row; }
.guide-column { flex-basis: 0; flex-grow: 1; margin-right: 18px; }
.control-row { padding-bottom: 10px; margin-bottom: 8px; border-bottom-width: 1px; border-bottom-color: rgb(57, 77, 83); }
.control-key { font-size: 12px; color: rgb(226, 203, 166); margin-bottom: 3px; white-space: normal; }
.control-description { font-size: 11px; color: rgb(155, 184, 187); white-space: normal; }
.guide-actions { flex-direction: row; margin-top: 13px; }
.guide-actions Button { min-width: 150px; min-height: 46px; }
.negative { color: rgb(244, 159, 134); }
.compact .identity-copy, .compact .occupancy { display: none; }
.compact .identity { margin-right: 12px; }
.compact .brand-mark { width: 38px; height: 38px; margin-right: 0; font-size: 15px; }
.compact .balance { min-width: 105px; margin-right: 10px; }
.compact .cash { font-size: 22px; }
.compact .header { padding-left: 9px; padding-right: 9px; }
.compact .metric-label { font-size: 8px; letter-spacing: 1px; margin-bottom: 4px; }
.compact .time-control { margin-right: 8px; }
.compact .clock { font-size: 10px; margin-bottom: 2px; }
.compact Button.speed-button { min-height: 44px; min-width: 44px; }
.compact .header-actions Button { min-width: 55px; padding-left: 9px; padding-right: 9px; font-size: 11px; }
.compact .inspector { width: 280px; padding: 12px 10px; }
.compact .card-title { font-size: 20px; }
.compact .workspace-tabs Button { min-width: 88px; min-height: 44px; padding-left: 12px; padding-right: 12px; }
.compact .navigation-utilities Button { min-height: 44px; padding-left: 10px; padding-right: 10px; font-size: 12px; }
.compact .tools { min-height: 64px; }
.compact .status { padding: 9px 11px; }
.compact .instruction { font-size: 11px; }
.compact .notice { font-size: 10px; }
.compact .cards { flex-direction: column; margin-left: 0; margin-right: 0; }
.compact .contract-card { flex-basis: auto; margin: 0 0 14px 0; padding: 19px; }
.compact .contract-topline { margin-bottom: 16px; }
.compact .contract-description { min-height: 0; margin-bottom: 12px; }
.compact .contract-footnote { flex-grow: 0; }
.compact .menu-title { font-size: 36px; }
.compact .menu-subtitle { font-size: 16px; }
.compact .menu-intro { font-size: 12px; }
.compact .menu-masthead { margin-bottom: 15px; padding-bottom: 10px; }
.compact .menu-brand { font-size: 10px; letter-spacing: 1.8px; }
.compact .guide-sheet { padding: 18px; }
.compact .guide-title { font-size: 26px; }
.narrow .header-actions Button { min-width: 50px; font-size: 10px; padding-left: 6px; padding-right: 6px; }
.narrow .header .identity { margin-right: 7px; }
.narrow .balance { margin-right: 7px; min-width: 95px; }
.narrow .cash { font-size: 20px; }
.narrow .guide-columns { flex-direction: column; }
.narrow .guide-column { flex-basis: auto; margin-right: 0; }
.narrow .workspace-tabs Button { min-width: 76px; }
.narrow .navigation-utilities Button { font-size: 11px; padding-left: 8px; padding-right: 8px; }
.compact .finance-name, .compact .finance-value { font-size: 13px; }
.compact .contract-description { font-size: 14px; }
.compact .contract-footnote { font-size: 12px; }
.compact .contract-tag, .compact .contract-topline .eyebrow { font-size: 10px; }
.compact .menu-intro { font-size: 13px; }
.compact .muted { font-size: 12px; }
.compact .instruction { font-size: 12px; }
.compact .notice { font-size: 11px; }
.compact .terms { font-size: 13px; }

.masthead-actions { flex-direction: row; align-items: center; }
.masthead-actions Button { min-height: 44px; font-size: 12px; }
.saved-holdings { padding: 9px; background-color: rgb(23, 34, 39); border-width: 1px; border-color: rgb(54, 74, 80); border-radius: 5px; margin-bottom: 14px; }
.unity-scroller--vertical { width: 7px; min-width: 7px; margin-left: 5px; background-color: rgba(0, 0, 0, 0); }
.unity-scroller--vertical .unity-scroller__low-button, .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.unity-scroller--vertical .unity-base-slider { width: 7px; min-width: 7px; margin: 0; padding: 0; }
.unity-scroller--vertical .unity-base-slider__tracker { width: 5px; border-width: 0; border-radius: 3px; background-color: rgb(36, 50, 56); }
.unity-scroller--vertical .unity-base-slider__dragger { width: 5px; min-height: 25px; border-width: 0; border-radius: 3px; background-color: rgb(95, 116, 118); }
.unity-scroller--vertical .unity-base-slider__dragger-border { display: none; }
.unity-scroller--horizontal .unity-scroller__low-button, .unity-scroller--horizontal .unity-scroller__high-button { display: none; }
.compact .masthead-actions Button { font-size: 11px; padding-left: 9px; padding-right: 9px; }
.narrow .menu-masthead { flex-direction: column; align-items: flex-start; }
.narrow .masthead-actions { margin-top: 10px; flex-wrap: wrap; }
/* Construction is a categorized catalog; the floor view keeps a small utility dock. */
.tools { min-height: 82px; padding: 9px; }
.tool-strip { flex-wrap: nowrap; }
.tool-strip .tool-button { min-width: 84px; padding-left: 12px; padding-right: 12px; margin-right: 4px; }
.tool-strip .snap-button { min-width: 92px; margin-left: 4px; }
.active-build-item { font-size: 11px; color: rgb(223, 197, 157); margin: 0 3px 7px 3px; white-space: normal; }
.catalog-categories { flex-direction: row; flex-wrap: wrap; margin: -3px -3px 12px -3px; }
Button.category-button { width: 31%; flex-grow: 1; flex-basis: 28%; min-width: 82px; min-height: 44px; padding: 4px; margin: 3px; font-size: 10px; }
Button.catalog-item { align-items: stretch; min-height: 114px; margin: 0 0 9px 0; padding: 12px; background-color: rgb(35, 47, 52); border-color: rgb(64, 84, 89); -unity-text-align: upper-left; }
Button.catalog-item:hover { background-color: rgb(47, 66, 71); border-color: rgb(135, 159, 155); }
Button.catalog-item.selected { background-color: rgb(60, 66, 59); border-color: rgb(219, 190, 145); }
.catalog-item-title { font-size: 14px; -unity-font-style: bold; color: rgb(231, 234, 223); margin-bottom: 7px; white-space: normal; }
.catalog-item-description { font-size: 11px; color: rgb(166, 188, 187); white-space: normal; margin-bottom: 10px; }
.catalog-item-footer { flex-direction: row; align-items: center; justify-content: space-between; }
.catalog-item-detail { font-size: 10px; color: rgb(144, 173, 177); flex-grow: 1; margin-right: 7px; white-space: normal; }
.catalog-item-price { font-size: 13px; color: rgb(227, 199, 154); -unity-font-style: bold; white-space: normal; -unity-text-align: middle-right; }
.people-summary { color: rgb(156, 180, 179); font-size: 11px; white-space: normal; margin-bottom: 14px; }
.people-intro .section-label { margin-top: 0; }
.person-card { background-color: rgb(34, 46, 51); border-width: 1px; border-color: rgb(65, 86, 91); border-radius: 5px; padding: 14px; margin-bottom: 8px; }
.person-card .eyebrow { font-size: 9px; letter-spacing: 0.7px; }
.person-name { font-size: 24px; -unity-font-style: bold; color: rgb(241, 231, 208); white-space: normal; margin-bottom: 5px; }
.person-summary { color: rgb(190, 211, 207); font-size: 13px; white-space: normal; margin-bottom: 8px; }
.person-affiliation { font-size: 11px; color: rgb(148, 177, 181); white-space: normal; margin-bottom: 14px; }
.person-metrics { flex-direction: row; margin-bottom: 12px; padding: 11px 0; border-top-width: 1px; border-top-color: rgb(61, 82, 87); border-bottom-width: 1px; border-bottom-color: rgb(61, 82, 87); }
.person-metric { flex-grow: 1; flex-basis: 0; }
.person-metric-value { font-size: 21px; color: rgb(219, 211, 185); margin-bottom: 4px; }
.person-metric-value.negative { color: rgb(244, 159, 134); }
.person-metric-label { font-size: 8px; color: rgb(147, 176, 178); letter-spacing: 0.7px; }
.person-effect { white-space: normal; font-size: 12px; color: rgb(211, 220, 203); padding: 11px; background-color: rgb(42, 59, 59); border-left-width: 2px; border-left-color: rgb(180, 160, 124); border-radius: 3px; }
.person-card .section-label { margin-top: 16px; }
.trait-row { margin-bottom: 8px; }
.trait-labels { flex-direction: row; justify-content: space-between; margin-bottom: 6px; }
.trait-name, .trait-value { font-size: 11px; color: rgb(174, 198, 194); }
.trait-value { color: rgb(213, 211, 184); }
.trait-fill { height: 4px; background-color: rgb(155, 183, 171); }
Button.relationship-row { min-height: 55px; margin: 0 0 6px 0; padding: 8px; font-size: 11px; white-space: normal; -unity-text-align: middle-left; background-color: rgb(41, 57, 61); }
Button.relationship-row.relationship-conflict { color: rgb(238, 180, 153); border-left-width: 2px; border-left-color: rgb(201, 132, 105); }
.roster-toggles { flex-direction: row; margin-bottom: 9px; }
.roster-toggles Button { flex-basis: 0; flex-grow: 1; min-height: 44px; font-size: 12px; }
Button.person-roster-row { min-height: 58px; margin: 0 0 6px 0; padding: 8px 11px; -unity-text-align: middle-left; white-space: normal; font-size: 12px; background-color: rgb(35, 47, 52); border-color: rgb(59, 78, 84); }
Button.person-roster-row.selected { background-color: rgb(66, 68, 57); border-color: rgb(217, 188, 144); color: rgb(236, 219, 185); }
Button.staff-support { margin: 12px 0 0 0; min-height: 46px; }
.social-event { color: rgb(170, 190, 184); font-size: 11px; white-space: normal; padding-bottom: 12px; margin-bottom: 10px; border-bottom-width: 1px; border-bottom-color: rgb(55, 76, 82); }
.compact .tools { min-height: 82px; }
.compact .catalog-item-description { font-size: 12px; }
.compact .catalog-item-title { font-size: 15px; }
.compact Button.category-button { min-width: 78px; font-size: 10px; }
.compact .workspace-tabs Button { min-width: 76px; padding-left: 10px; padding-right: 10px; }
.narrow .workspace-tabs Button { min-width: 65px; padding-left: 8px; padding-right: 8px; font-size: 12px; }
.narrow .person-name { font-size: 22px; }

Button.category-button { white-space: normal; }

.compact-acquire, .contract-detail-toggle { display: none; }
.contract-details { flex-grow: 1; }
.compact .menu-subtitle, .compact .menu-intro { display: none; }
.compact .menu-title { font-size: 30px; margin-bottom: 16px; }
.compact .contract-details { display: none; flex-grow: 0; }
.compact .contract-details.expanded { display: flex; }
.compact Button.compact-acquire { display: flex; margin: 0 0 7px 0; min-height: 48px; }
.compact Button.contract-detail-toggle { display: flex; margin: 0; min-height: 44px; font-size: 12px; }
.compact Button.acquire-button { display: none; }
.compact .contract-card { padding: 15px; }
.compact .contract-topline { margin-bottom: 10px; }
.compact .contract-title { margin-bottom: 8px; }
.compact .contract-description { margin-bottom: 9px; }
.compact .reserve-block { padding-top: 8px; padding-bottom: 8px; margin-bottom: 12px; }
.compact .reserve-value { font-size: 29px; }

Button.person-roster-row.staff-risk { color: rgb(239, 181, 151); border-left-width: 2px; border-left-color: rgb(206, 133, 104); }

Button.placement-rotate { min-width: 96px; min-height: 44px; margin-right: 4px; padding-left: 9px; padding-right: 9px; font-size: 12px; }

/* Phone panels start with the decision content and use the full right-hand height. */
.catalog-compact-heading, .people-compact-heading { display: none; }
.person-metrics { flex-wrap: wrap; }
.person-metric { flex-basis: 45%; min-width: 0; margin-bottom: 9px; }
.person-metric-value { font-size: 19px; white-space: normal; }
.compact-build .inspector-heading, .compact-build .inspector-title, .compact-build .overview,
.compact-people .inspector-heading, .compact-people .inspector-title, .compact-people .overview,
.compact-people .people-summary { display: none; }
.compact-build .inspector, .compact-people .inspector { padding: 6px; }
.compact .catalog-compact-heading, .compact .people-compact-heading { display: flex; flex-direction: row; align-items: center; margin-bottom: 7px; }
.compact .people-compact-heading .eyebrow { flex-grow: 1; margin-bottom: 0; font-size: 9px; letter-spacing: 0.5px; }
Button.catalog-category-toggle { flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-width: 0; min-height: 44px; margin: 0 5px 0 0; padding-left: 9px; padding-right: 9px; font-size: 12px; -unity-text-align: middle-left; }
Button.compact-panel-close { width: 48px; min-width: 48px; max-width: 48px; flex-basis: 48px; flex-grow: 0; flex-shrink: 0; min-height: 44px; padding-left: 6px; padding-right: 6px; margin: 0 0 0 3px; font-size: 11px; }
.compact Button.catalog-item { min-height: 102px; padding: 10px; margin-bottom: 8px; }
.compact .catalog-item-title { font-size: 14px; margin-bottom: 5px; }
.compact .catalog-item-description { font-size: 11px; margin-bottom: 7px; }
.compact .catalog-item-price { font-size: 12px; }
.compact .person-card { padding: 8px; }
.compact .person-card > .panel-heading { display: none; }
.compact .person-name { font-size: 21px; margin-bottom: 3px; }
.compact .person-summary { font-size: 11px; margin-bottom: 5px; }
.compact .person-affiliation { font-size: 10px; margin-bottom: 8px; }
.compact .person-metrics { padding-top: 6px; padding-bottom: 0; margin-bottom: 7px; }
.compact .person-metric { margin-bottom: 6px; }
.compact .person-metric-value { font-size: 17px; margin-bottom: 2px; }
.compact .person-metric-label { font-size: 8px; }
.compact .person-effect { font-size: 11px; padding: 8px; }
.compact .tools { min-height: 64px; padding: 6px; }
.compact .active-build-item { display: none; }
.compact .tool-strip .tool-button { min-width: 64px; padding-left: 8px; padding-right: 8px; }
.compact .tool-strip .snap-button { min-width: 80px; padding-left: 8px; padding-right: 8px; }
.compact Button.placement-rotate { min-width: 88px; }

/* Operations and packaged construction */
.package-selector, .operations-switches { flex-direction: row; flex-wrap: wrap; margin-bottom: 9px; }
.package-selector Button { flex-grow: 1; flex-basis: 0; min-height: 44px; padding-left: 5px; padding-right: 5px; font-size: 12px; }
.operations-switches Button { flex-grow: 1; width: 46%; min-height: 46px; margin: 3px; font-size: 12px; }
.cctv-feed { width: 100%; height: 174px; background-color: rgb(7, 13, 15); margin-top: 8px; margin-bottom: 8px; }
.control-pane > Button { margin-bottom: 6px; min-height: 44px; }
.control-compact-heading { display: none; }
.compact-control .inspector-heading, .compact-control .inspector-title, .compact-control .overview { display: none; }
.compact .control-compact-heading { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 7px; }
.compact .control-pane .body { font-size: 12px; }
.compact .cctv-feed { height: 145px; }
