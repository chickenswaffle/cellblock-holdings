/* Justice / custody presentation. Loaded by GameJusticeHud; Cellblock.uss is not modified. */
.custody-panel { padding: 10px 10px 6px 10px; margin-top: 4px; margin-bottom: 10px; border-width: 1px; border-color: rgb(70, 86, 87); border-radius: 5px; background-color: rgb(34, 44, 47); }
.custody-heading { color: rgb(187, 164, 132); font-size: 10px; letter-spacing: 1.5px; margin-bottom: 7px; }
.custody-line { white-space: normal; font-size: 12px; color: rgb(214, 222, 213); margin-bottom: 5px; flex-shrink: 1; flex-grow: 1; }
.custody-muted { white-space: normal; font-size: 11px; color: rgb(146, 165, 165); margin-bottom: 6px; }
.custody-row { flex-direction: row; align-items: center; justify-content: space-between; }
Button.custody-review { min-width: 72px; font-size: 11px; padding-left: 8px; padding-right: 8px; }
.custody-warning { white-space: normal; color: rgb(236, 190, 118); font-size: 12px; margin-bottom: 5px; }
.custody-alert { margin-top: 6px; padding: 9px 8px 4px 8px; border-width: 1px; border-color: rgb(176, 78, 60); border-radius: 4px; background-color: rgb(58, 34, 31); }
.custody-alert-text { white-space: normal; color: rgb(246, 182, 160); font-size: 12px; -unity-font-style: bold; margin-bottom: 6px; }
.custody-demo { margin-top: 6px; opacity: 0.8; }

.legal-card { margin-top: 2px; margin-bottom: 12px; padding: 9px 10px 6px 10px; border-left-width: 3px; border-left-color: rgb(187, 164, 132); border-radius: 3px; background-color: rgb(32, 41, 44); }
.legal-heading { flex-direction: row; justify-content: space-between; align-items: center; min-height: 30px; }
.legal-eyebrow { color: rgb(152, 173, 173); font-size: 10px; letter-spacing: 1.4px; }
Button.legal-toggle { margin-top: -8px; margin-bottom: -8px; }
.legal-chips { flex-direction: row; flex-wrap: wrap; margin-bottom: 6px; }
.legal-chip { font-size: 10px; letter-spacing: 0.8px; padding: 3px 7px; margin-right: 5px; margin-bottom: 4px; border-width: 1px; border-color: rgb(80, 94, 95); border-radius: 3px; color: rgb(214, 222, 213); }
.legal-chip.risk-elevated { border-color: rgb(196, 152, 82); color: rgb(236, 196, 128); }
.legal-chip.risk-high { border-color: rgb(196, 86, 66); background-color: rgb(70, 36, 32); color: rgb(248, 180, 160); }
.legal-line { white-space: normal; font-size: 12px; color: rgb(210, 218, 210); margin-bottom: 5px; }
.legal-court { white-space: normal; font-size: 11px; color: rgb(170, 188, 184); margin-bottom: 4px; }
.legal-label { color: rgb(187, 164, 132); font-size: 9px; letter-spacing: 1.4px; margin-top: 9px; margin-bottom: 4px; }
.legal-event { white-space: normal; font-size: 11px; color: rgb(190, 202, 196); padding: 5px 0; border-bottom-width: 1px; border-bottom-color: rgb(55, 67, 69); }

Button.person-roster-row.roster-away { opacity: 0.62; }
Button.person-roster-row.roster-risk { border-left-width: 3px; border-left-color: rgb(196, 86, 66); }

.compact .custody-panel { padding: 8px 8px 4px 8px; }
.compact .legal-card { padding: 7px 8px 4px 8px; }
.compact .custody-line, .compact .legal-line { font-size: 11px; }
