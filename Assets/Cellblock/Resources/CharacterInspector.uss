.character-sheet { position: absolute; background-color: rgb(20, 29, 33); border-color: rgb(91, 106, 105); border-width: 1px; border-radius: 12px; padding: 12px; overflow: hidden; }
.character-sheet-bar { flex-direction: row; justify-content: space-between; flex-shrink: 0; }
.character-back { min-height: 44px; background-color: rgba(0,0,0,0); border-width: 0; color: rgb(181, 195, 192); font-size: 13px; padding-left: 5px; padding-right: 5px; }
.character-identity { padding: 6px 3px 12px 3px; flex-shrink: 0; }
.character-tag { color: rgb(192, 166, 111); font-size: 10px; letter-spacing: 1px; white-space: normal; }
.character-name { color: rgb(244, 237, 220); font-size: 23px; -unity-font-style: bold; white-space: normal; margin-top: 3px; }
.character-tabs { flex-direction: row; flex-shrink: 0; margin-bottom: 8px; border-bottom-width: 1px; border-bottom-color: rgb(64, 78, 80); }
.character-tab { flex-grow: 1; flex-basis: 0; min-height: 44px; border-width: 0; border-radius: 4px; margin: 0 2px 5px 0; font-size: 12px; color: rgb(173, 190, 187); background-color: rgb(29, 42, 46); }
.character-tab.selected { background-color: rgb(199, 168, 104); color: rgb(24, 31, 32); -unity-font-style: bold; }
.character-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.character-page { padding: 4px 5px 10px 2px; }
.character-kicker { font-size: 10px; color: rgb(165, 184, 181); margin: 9px 0 6px 0; letter-spacing: 1px; white-space: normal; }
.character-goal { font-size: 19px; -unity-font-style: bold; color: rgb(240, 235, 219); white-space: normal; margin-bottom: 9px; }
.character-blocker { color: rgb(234, 171, 122); background-color: rgb(60, 43, 35); border-left-width: 2px; border-left-color: rgb(211, 156, 91); padding: 8px; font-size: 12px; white-space: normal; margin-bottom: 8px; }
.character-vitals { flex-direction: row; margin-bottom: 10px; }
.character-vital { flex-grow: 1; flex-basis: 0; background-color: rgb(29, 41, 45); border-radius: 5px; padding: 8px 6px; margin-right: 5px; }
.character-vital-label { color: rgb(206, 218, 212); white-space: normal; font-size: 12px; }
.character-vital-track { height: 4px; margin-top: 7px; background-color: rgb(53, 66, 68); border-radius: 2px; }
.character-vital-fill { height: 4px; border-radius: 2px; }
.character-detail { color: rgb(195, 211, 205); font-size: 13px; white-space: normal; margin-bottom: 10px; }
.character-disclosure { min-height: 44px; border-width: 0; border-radius: 4px; background-color: rgb(28, 40, 43); color: rgb(206, 190, 153); font-size: 12px; white-space: normal; margin: 3px 0; }
.character-memory { color: rgb(188, 206, 201); font-size: 12px; white-space: normal; border-top-width: 1px; border-top-color: rgb(52, 68, 70); padding: 10px 0; }
.character-traits { flex-direction: row; flex-wrap: wrap; }
.character-traits .stat-meter { width: 47%; margin-right: 5px; }
.character-relation { min-height: 44px; border-width: 0; background-color: rgb(35, 49, 53); color: rgb(215, 222, 207); white-space: normal; -unity-text-align: middle-left; margin: 3px 0; }
.character-footer { border-top-width: 1px; border-top-color: rgb(64, 78, 80); padding-top: 8px; flex-shrink: 0; }
.character-actions { flex-direction: row; }
.character-primary, .character-secondary { min-height: 46px; border-radius: 6px; border-width: 0; font-size: 14px; -unity-font-style: bold; }
.character-primary { flex-grow: 2; background-color: rgb(199, 168, 104); color: rgb(24, 31, 32); margin-right: 6px; }
.character-secondary { flex-grow: 1; color: rgb(216, 222, 207); background-color: rgb(43, 62, 66); }
.character-roster-row { min-height: 66px; flex-shrink: 0; margin-bottom: 6px; border-radius: 6px; border-width: 0; background-color: rgb(31, 46, 50); color: rgb(224, 228, 213); white-space: normal; font-size: 14px; -unity-text-align: middle-left; padding: 8px 12px; }
.character-roster-count { color: rgb(175, 194, 190); font-size: 12px; white-space: normal; margin: 5px 3px 12px 3px; }
.character-control-bar { position: absolute; border-radius: 10px; background-color: rgba(17, 28, 32, 0.95); border-width: 1px; border-color: rgb(85, 103, 104); padding: 8px 12px; }
.character-control-top { flex-direction: row; align-items: center; }
.character-control-exit { min-height: 46px; border-width: 0; border-radius: 5px; background-color: rgb(199, 168, 104); color: rgb(24, 31, 32); font-size: 13px; padding: 0 12px; }
.character-control-name { flex-grow: 1; color: rgb(235, 231, 211); font-size: 18px; -unity-font-style: bold; padding: 0 16px; white-space: normal; }
.character-control-actions { flex-direction: row; flex-shrink: 0; }
.character-control-button { min-height: 46px; background-color: rgb(36, 54, 59); color: rgb(209, 219, 211); border-width: 0; border-radius: 5px; margin-left: 5px; font-size: 12px; padding: 0 10px; }
.character-control-help { color: rgb(160, 182, 179); font-size: 12px; margin-top: 5px; white-space: normal; }
.character-control-compact .character-control-top { flex-wrap: wrap; }
.character-control-compact .character-control-actions { flex-grow: 1; }
.character-control-compact .character-control-name { font-size: 15px; }
.character-control-compact .character-control-button { flex-grow: 1; }
.character-context { position: absolute; background-color: rgba(20, 31, 34, 0.9); color: rgb(222, 222, 198); font-size: 13px; white-space: normal; -unity-text-align: middle-center; border-radius: 6px; padding: 10px; }
.character-stick { position: absolute; width: 112px; height: 112px; border-radius: 56px; background-color: rgba(25, 43, 48, 0.7); border-width: 2px; border-color: rgba(198, 186, 146, 0.5); align-items: center; justify-content: center; }
.character-stick-knob { position: absolute; left: 35px; top: 35px; width: 38px; height: 38px; border-radius: 19px; background-color: rgba(197, 177, 126, 0.7); }
.character-stick-label { position: absolute; bottom: 8px; font-size: 10px; color: rgb(218, 218, 188); -unity-text-align: middle-center; }
.compact .character-footer > .character-disclosure { display: none; }
