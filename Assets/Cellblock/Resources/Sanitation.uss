/* Sanitation: the Pressure workspace section and the hygiene block on a resident's card. Loaded by GameSanitationHud; other style sheets are not modified. */
.outbreak-card { padding: 9px 10px 1px 10px; margin: 6px 0 4px 0; border-left-width: 3px; border-left-color: rgb(196, 160, 58); border-radius: 3px; background-color: rgb(52, 46, 26); }
.sanitation-row { white-space: normal; font-size: 11px; color: rgb(205, 214, 206); padding: 5px 8px; margin-bottom: 3px; border-radius: 3px; background-color: rgb(30, 40, 44); }
.sanitation-row.short { color: rgb(240, 206, 150); background-color: rgb(56, 44, 30); }
.sanitation-actions Button { min-height: 44px; flex-grow: 1; font-size: 11px; padding-left: 7px; padding-right: 7px; margin-bottom: 4px; }
.hygiene-card { padding: 8px 10px 4px 10px; margin: 8px 0 6px 0; border-left-width: 3px; border-left-color: rgb(96, 164, 196); border-radius: 3px; background-color: rgb(28, 38, 44); }
.hygiene-card .section-label { margin-top: 0; }
.hygiene-illness { white-space: normal; font-size: 11px; color: rgb(236, 196, 140); padding: 5px 6px; margin-bottom: 4px; border-radius: 3px; background-color: rgba(184, 124, 47, 0.12); }
