/* Resident lives: the Life block on a resident's card. Loaded by GameLivesHud; other style sheets are not modified. */
.life-card { padding: 8px 10px 4px 10px; margin: 8px 0 6px 0; border-left-width: 3px; border-left-color: rgb(140, 180, 132); border-radius: 3px; background-color: rgb(32, 40, 34); }
.life-card .section-label { margin-top: 0; }
.life-chapter { white-space: normal; font-size: 12px; letter-spacing: 1px; -unity-font-style: bold; color: rgb(220, 236, 210); margin-bottom: 3px; }
.life-now { white-space: normal; font-size: 12px; color: rgb(236, 228, 204); margin-bottom: 4px; }
.life-line { white-space: normal; font-size: 11px; color: rgb(184, 196, 188); margin-bottom: 4px; }
.life-memory { white-space: normal; font-size: 11px; color: rgb(205, 214, 206); padding: 4px 6px; margin-bottom: 2px; border-radius: 3px; background-color: rgb(26, 33, 30); }
.life-purpose { white-space: normal; font-size: 12px; color: rgb(210, 218, 207); margin-bottom: 7px; }
.life-next { white-space: normal; font-size: 11px; color: rgb(166, 194, 200); margin-top: 3px; margin-bottom: 5px; }
.life-blocker { white-space: normal; font-size: 11px; color: rgb(231, 190, 134); padding: 6px; margin-bottom: 6px; border-left-width: 2px; border-left-color: rgb(194, 151, 81); background-color: rgba(184, 124, 47, 0.09); }
.life-suggestions Button { min-width: 64px; min-height: 44px; flex-grow: 1; font-size: 11px; padding-left: 7px; padding-right: 7px; margin-bottom: 4px; }
